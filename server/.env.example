# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facets57
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ─────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ── OTP ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ── Email / SMTP ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="57 Facets <your_smtp_user@example.com>"
# Comma-separated admin recipients for login alerts.
# If empty, falls back to all active admins in the DB.
ADMIN_NOTIFY_EMAIL=
